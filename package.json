{
  "name": "mizan-icons-monorepo",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "fetch:figma": "tsx scripts/fetch-figma.ts",
    "ingest": "tsx scripts/ingest-manual-export.ts",
    "optimize": "tsx scripts/optimize-svgs.ts",
    "codegen:react": "tsx scripts/generate-react.ts",
    "build:react": "pnpm --filter @abez/icons build",
    "build": "pnpm optimize && pnpm codegen:react && pnpm build:react",
    "sync": "pnpm fetch:figma && pnpm build"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "dotenv": "^16.4.5",
    "svgo": "^3.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
